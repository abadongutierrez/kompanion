DATABASE_URL=postgres://sdlc:sdlc@localhost:5433/sdlc
PORT=3100

# Path to the real Claude Code binary. On machines where `claude` on $PATH is
# a shell function (e.g. a guarded wrapper in ~/.zshrc), child_process.spawn
# can't resolve it directly — point this at the actual executable instead,
# e.g. ~/.local/bin/claude.
CLAUDE_BIN=claude

# Heartbeats: a background scheduler that automatically runs eligible backlog
# tasks with real, billed Claude Code invocations — no button click. OFF by
# default; only enable if you actually want autonomous execution running.
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_MS=30000
