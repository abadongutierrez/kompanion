# The Kotlin server reads SPRING_DATASOURCE_* (see
# server-kotlin/src/main/resources/application.yml); these defaults match
# docker-compose.dev.yml, so you only need to set them if you move the DB.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/sdlc
SPRING_DATASOURCE_USERNAME=sdlc
SPRING_DATASOURCE_PASSWORD=sdlc
PORT=3200

# Path to the real Claude Code binary. On machines where `claude` on $PATH is
# a shell function (e.g. a guarded wrapper in ~/.zshrc), the runner
# can't resolve it directly — point this at the actual executable instead,
# e.g. ~/.local/bin/claude.
CLAUDE_BIN=claude

# Heartbeats: a background scheduler that automatically runs eligible backlog
# tasks with real, billed Claude Code invocations — no button click. OFF by
# default; only enable if you actually want autonomous execution running.
HEARTBEAT_ENABLED=false
HEARTBEAT_INTERVAL_MS=30000

# Where workspace/ (harnesses/ templates + tasks/ per-task runtime scratch)
# lives. Optional: the server defaults to the repo-root workspace/ folder
# on its own; only set this if you need it somewhere else.
# WORKSPACE_ROOT=/absolute/path/to/workspace
