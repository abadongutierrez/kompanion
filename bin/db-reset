#!/bin/bash
set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${RED}⚠️  Database Reset${NC}"
echo -e "This will drop all data and re-run migrations.\n"

# Confirm
read -p "Are you sure? (y/N): " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
  echo -e "${YELLOW}Cancelled${NC}"
  exit 0
fi

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

echo -e "\n${BLUE}Stopping database container...${NC}"
docker compose -f docker-compose.dev.yml down -v 2>/dev/null || true
sleep 1

echo -e "${BLUE}Starting fresh database...${NC}"
docker compose -f docker-compose.dev.yml up -d --quiet-pull 2>&1 | grep -E "Starting|Created|Already|Health" || true
sleep 2

echo -e "${BLUE}⏳ Waiting for PostgreSQL...${NC}"
for i in {1..30}; do
  if docker exec sdlc-kompanion-db pg_isready -U postgres &> /dev/null; then
    echo -e "${GREEN}✓ PostgreSQL ready${NC}\n"
    echo -e "${BLUE}Running migrations...${NC}"
    pnpm db:migrate 2>&1 | tail -3 || true
    echo -e "${GREEN}✓ Database reset complete${NC}"
    echo -e "${YELLOW}Note: Run './bin/start' to start the app${NC}\n"
    break
  fi
  if [ $i -eq 30 ]; then
    echo -e "${RED}❌ PostgreSQL failed to start${NC}"
    exit 1
  fi
  sleep 1
done
