#!/bin/bash
set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIDS_FILE="$PROJECT_ROOT/.dev_pids_ts"

echo -e "${GREEN}▶️  Starting SDLC Kompanion (TypeScript Server + UI)${NC}\n"

# Cleanup function
cleanup() {
  echo -e "\n${YELLOW}⏹️  Shutting down services...${NC}"

  # Kill processes from .dev_pids_ts if they exist
  if [ -f "$PIDS_FILE" ]; then
    while IFS= read -r pid; do
      if kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
      fi
    done < "$PIDS_FILE"
    rm "$PIDS_FILE"
  fi

  # Stop Docker
  echo -e "${BLUE}📦 Stopping PostgreSQL...${NC}"
  docker compose -f "$PROJECT_ROOT/docker-compose.dev.yml" down 2>/dev/null || true

  echo -e "${GREEN}✓ All services stopped${NC}"
  exit 0
}

trap cleanup EXIT INT TERM

# Check Docker
if ! docker ps &> /dev/null; then
  echo -e "${RED}❌ Docker daemon not running. Start Docker Desktop.${NC}"
  exit 1
fi

# Start database
echo -e "${BLUE}📦 Starting PostgreSQL...${NC}"
cd "$PROJECT_ROOT"
docker compose -f docker-compose.dev.yml up -d --quiet-pull 2>&1 | grep -E "Starting|Created|Already|Health" || true
sleep 2

# Check database is ready
echo -e "${BLUE}⏳ Waiting for PostgreSQL to be ready...${NC}"
for i in {1..30}; do
  if docker exec sdlc-kompanion-db pg_isready -U postgres &> /dev/null; then
    echo -e "${GREEN}✓ PostgreSQL ready${NC}\n"
    break
  fi
  if [ $i -eq 30 ]; then
    echo -e "${RED}❌ PostgreSQL failed to start${NC}"
    exit 1
  fi
  sleep 1
done

# Run migrations
echo -e "${BLUE}🔄 Running database migrations...${NC}"
pnpm db:migrate 2>&1 | tail -3 || true
echo -e "${GREEN}✓ Migrations complete${NC}"

# Start TypeScript server
echo -e "\n${BLUE}🚀 Starting services...${NC}"
echo -e "${BLUE}   TypeScript Server on http://localhost:3000${NC}"
pnpm dev:server > "$PROJECT_ROOT/.server.log" 2>&1 &
SERVER_PID=$!
echo "$SERVER_PID" >> "$PIDS_FILE"
sleep 2

# Start React UI
echo -e "${BLUE}   React UI on http://localhost:5173${NC}"
pnpm dev:ui > "$PROJECT_ROOT/.ui.log" 2>&1 &
UI_PID=$!
echo "$UI_PID" >> "$PIDS_FILE"
sleep 2

echo -e "\n${GREEN}✓ All services started${NC}"
echo -e "${YELLOW}Press Ctrl+C to stop${NC}\n"

# Wait for processes
wait $SERVER_PID $UI_PID 2>/dev/null || true
