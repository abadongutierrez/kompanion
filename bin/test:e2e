#!/bin/bash
set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}🎭 Running e2e tests with Playwright${NC}\n"

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

# Check if services are running
echo -e "${YELLOW}Checking if services are running...${NC}"
if ! curl -s http://localhost:3000/health &> /dev/null; then
  echo -e "${YELLOW}⚠️  Services not running. Run './bin/start' in another terminal first.${NC}\n"
fi

# Run e2e tests
echo -e "${BLUE}Running e2e tests...${NC}\n"
if pnpm test:e2e; then
  echo -e "\n${GREEN}✅ All e2e tests passed${NC}\n"
else
  echo -e "\n${RED}❌ Some e2e tests failed${NC}"
  exit 1
fi
