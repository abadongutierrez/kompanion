#!/bin/bash

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${GREEN}🧹 Cleaning build artifacts and containers${NC}\n"

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

# Stop running services
PIDS_FILE="$PROJECT_ROOT/.dev_pids"
if [ -f "$PIDS_FILE" ]; then
  echo -e "${BLUE}Stopping running services...${NC}"
  while IFS= read -r pid; do
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
  done < "$PIDS_FILE"
  rm "$PIDS_FILE"
fi

# Remove node_modules and build artifacts
echo -e "${BLUE}Removing node_modules and build artifacts...${NC}"
pnpm clean 2>/dev/null || true
find . -type d -name "dist" -o -name "build" -o -name ".next" | xargs rm -rf 2>/dev/null || true

# Remove Docker containers and volumes
echo -e "${BLUE}Removing Docker containers and volumes...${NC}"
docker compose -f docker-compose.dev.yml down -v 2>/dev/null || true

# Remove log files
echo -e "${BLUE}Removing log files...${NC}"
rm -f "$PROJECT_ROOT/.server.log" "$PROJECT_ROOT/.ui.log" "$PROJECT_ROOT/.kotlin-server.log"

echo -e "${GREEN}✓ Clean complete${NC}\n"
