node_modules/
dist/
.env
*.tsbuildinfo
.DS_Store
__pycache__/
*.pyc

# Runtime task workspaces under the workspace/ folder at the repo root.
# workspace/harnesses/ stays a pure, immutable template and IS tracked; only
# the mutable per-task scratch state is ignored. workspace/tasks/ is the
# pre-V21 flat location; workspace/projects/<project>/tasks/<task>/ is where
# they live now that a Project names its own workspace folder.
workspace/tasks/
workspace/projects/

# Scratch space for research notes, spikes and drafts that aren't part of
# the project itself. Never tracked.
.work/

# Claude Code's own per-session runtime lock for this repo, not project
# config — recreated automatically, nothing to track.
.claude/scheduled_tasks.lock
.ui.log
.kotlin-server.log
.dev_pids
